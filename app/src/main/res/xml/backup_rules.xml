<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude plaintext document files — encrypted at Phase 12 -->
    <exclude domain="file" path="documents"/>
    <!-- Exclude encrypted DB — key is device-bound, backup is useless on another device -->
    <exclude domain="database" path="aegis.db"/>
    <!-- Exclude crypto prefs — encrypted passphrase + IV, useless without hardware Keystore key -->
    <exclude domain="sharedpref" path="aegis_crypto.xml"/>
</full-backup-content>